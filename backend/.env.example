PORT=4000

# PostgreSQL bağlantısı.
# Yerel geliştirme (docker-compose, host portu 5433):
DATABASE_URL=postgres://pazarlama:pazarlama@localhost:5433/pazarlama
# Production örneği:
# DATABASE_URL=postgres://KULLANICI:SIFRE@HOST:5432/VERITABANI

# JWT auth (production'da güçlü rastgele bir değer kullanın)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

GOOGLE_PLACES_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_HEADER_IMAGE_URL=
WABA_ID=
MAX_SAFE_RESULTS=500
